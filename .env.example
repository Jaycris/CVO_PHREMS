APP_NAME=PHREMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=Asia/Manila

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Production uses `database`, drained every minute by the scheduler (see
# routes/console.php) since shared hosting has no persistent worker.
# Set this to `sync` for local development to run queued mail and
# notifications immediately, with no worker process to remember.
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# CRM (commission slips). The CRM owns every commission figure; this app
# only reads them. Leave the URL blank to keep the commission pages dormant.
CRM_API_BASE_URL=
CRM_HRIS_API_TOKEN=
# bearer | x-hris-token
CRM_HRIS_AUTH_HEADER=bearer
CRM_API_TIMEOUT=15
CRM_API_CACHE_TTL=300
# How long the agent list is held. Short, because this is setup somebody
# changes in the CRM and checks here moments later.
CRM_AGENT_CACHE_TTL=60
CRM_API_VERIFY_TLS=true

# What the CRM presents when calling this app's employee lookup.
# Different secret from CRM_HRIS_API_TOKEN above. Blank closes the API.
CRM_INBOUND_API_TOKEN=

# Addresses that count as being in the office, alongside the Office Networks page.
# Comma separated; a single address or a range. Leave empty to manage it all in the app.
# OFFICE_IP_ADDRESSES="203.0.113.5,203.0.113.0/24"
OFFICE_IP_ADDRESSES=
